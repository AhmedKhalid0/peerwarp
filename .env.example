# PeerWarp Environment Configuration Example
# ==========================================

# Signaling Server URL (WebSocket)
# Default for local development:
NEXT_PUBLIC_SIGNALING_URL=ws://127.0.0.1:8002/ws

# For production on Cloudflare Pages / Workers:
# NEXT_PUBLIC_SIGNALING_URL=wss://peerwarp-signaling.your-subdomain.workers.dev/ws

# Google AdSense Publisher ID (Optional Monetization)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# STUN / TURN Server Configuration (Comma-separated STUN URLs)
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
